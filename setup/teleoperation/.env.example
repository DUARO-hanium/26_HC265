# .env.local로 복사해 사용합니다. 현장 값이 들어간 파일은 commit하지 마세요.
CYCLO_DIR=/home/<USER>/robot_dependencies/cyclo_intelligence
OPEN_MANIPULATOR_DIR=/home/<USER>/robot_dependencies/open_manipulator
OPEN_MANIPULATOR_CONTAINER=open_manipulator
CYCLO_CONTAINER=cyclo_intelligence
WSL_DISTRO=<YOUR_WSL_DISTRO>
ROS_DOMAIN_ID=30
RMW_IMPLEMENTATION=rmw_zenoh_cpp
CAMERA1_UDP_PORT=5000
CAMERA2_UDP_PORT=5002
FOLLOWER_BY_ID=<FOLLOWER_SERIAL_BY_ID_BASENAME>
LEADER_BY_ID=<LEADER_SERIAL_BY_ID_BASENAME>
