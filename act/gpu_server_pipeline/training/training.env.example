# Copy this file to training.env and edit it for your machine.
# The file is sourced by Bash. Do not commit training.env or API keys.

# Runtime paths. Relative paths are resolved by the shell that launches a script,
# so absolute paths are recommended for data and shared server storage.
WORK_ROOT="${HOME}/lerobot_act_runtime"
VENV_DIR="${WORK_ROOT}/venv"
DATASET_ROOT="${WORK_ROOT}/data/my_lerobot_dataset"
OUTPUT_DIR="${WORK_ROOT}/outputs/act_run"

# A LeRobot dataset repo_id is still required when DATASET_ROOT is local.
DATASET_REPO_ID="your-hf-user/your-dataset"
# Optional immutable Hugging Face commit. Leave empty for an already-local dataset
# when no Hub revision should be requested.
DATASET_REVISION=""

# Physical GPU indices exposed to the two Accelerate worker processes.
GPU_IDS="0,1"
NUM_PROCESSES="2"
MIXED_PRECISION="bf16"
DYNAMO_BACKEND="no"

# Proven ACT/DDP defaults from the original two-GPU training run.
BATCH_SIZE_PER_GPU="4"
STEPS="100000"
SEED="1000"
EVAL_SPLIT="0.10"
LOG_FREQ="100"
EVAL_STEPS="2500"
MAX_EVAL_SAMPLES="0"
SAVE_FREQ="2500"
JOB_NAME="act_run"

# W&B is optional. Prefer an injected WANDB_API_KEY (CI/secret manager), or point
# WANDB_API_KEY_FILE to a chmod 600 file outside this Git repository.
WANDB_ENABLE="false"
WANDB_PROJECT="lerobot-act"
WANDB_API_KEY_FILE=""
WANDB_NOTES="LeRobot 0.6.0 ACT with official Accelerate DDP"

# tmux and passive temperature logging. Thresholds only emit warnings; they do
# not terminate training.
TMUX_SESSION="lerobot_act"
GPU_MONITOR_INTERVAL_S="60"
GPU_TEMP_WARNING_C="85"
GPU_TEMP_CRITICAL_C="90"
