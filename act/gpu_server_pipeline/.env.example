# Copy to .env and edit. This file is sourced by Bash; never use an untrusted file.

# Local repository and LeRobot 0.6 environment
LOCAL_VENV="${HOME}/.venvs/lerobot-v060"
ROS_SETUP="/opt/ros/jazzy/setup.bash"
OMX_WS_SETUP="${HOME}/ros2_ws/install/setup.bash"

# Existing ROBOTIS OpenManipulator Docker deployment
DOCKER_CONFIG_DIR="${HOME}/.docker"
OMX_CONTAINER="open_manipulator"
OMX_CONTAINER_WORKSPACE_HOST="${HOME}/ros2_ws/src/open_manipulator/docker/workspace"
OMX_CONTAINER_WORKSPACE="/workspace"

# Replace with your follower's stable by-id path. Never use ttyACM0 directly.
FOLLOWER_PORT="/dev/serial/by-id/REPLACE_WITH_YOUR_FOLLOWER_OPENRB"
ROS_DOMAIN_ID="30"
RMW_IMPLEMENTATION="rmw_fastrtps_cpp"

# Existing UDP->ROS gscam receiver helper from your OpenManipulator/camera setup
CAMERA_RECEIVER_SCRIPT="${HOME}/camera_bridge/run_gscam_receiver.sh"
CAMERA1_PORT="5000"
CAMERA2_PORT="5002"

# Remote GPU server. Configure this host in ~/.ssh/config or use user@hostname.
SSH_TARGET="gpu-server"
LOCAL_POLICY_PORT="58080"
REMOTE_POLICY_PORT="58080"

# Path visible on the GPU server. Set it to your own trained pretrained_model.
REMOTE_CHECKPOINT="/path/on/gpu-server/outputs/act_run/checkpoints/last/pretrained_model"

# Explicit robot/task profile. The bundled profile is reference-only and must be audited
# for the target robot before real mode.
# Leave empty until you have audited and deliberately selected a profile.
PROFILE_NAME=""
TASK_TEXT="Pick a sock from the container and place it on the table"

# Generic defaults remain dry-run and do not enable the task-specific gripper override.
DRY_RUN="true"
GRIPPER_HOLD_ENABLED="false"
