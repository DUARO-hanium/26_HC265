# USB 카메라는 숫자 인덱스, 네트워크 카메라는 RTSP/HTTP URL을 입력합니다.
# DUARO ESP32-CAM 펌웨어는 RTSP가 아닌 UDP JPEG(:8001)를 사용합니다.
CAMERA_1_SOURCE=udp://0.0.0.0:8001
CAMERA_1_SIMULATION=false

# RTSP가 끊기거나 응답하지 않을 때 UI 전체가 멈추지 않도록 제한합니다.
CAMERA_OPEN_TIMEOUT_MS=5000
CAMERA_READ_TIMEOUT_MS=5000
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# 브라우저 영상은 2Hz로 갱신하고 JPEG를 낮춰 끊김을 줄입니다.
UI_REFRESH_MS=500
UI_JPEG_QUALITY=75

# heuristic은 학습 없이 붉은 오염 후보를 찾습니다. yolo는 학습 가중치가 필요합니다.
INSPECTION_BACKEND=heuristic

# INSPECTION_BACKEND=yolo일 때만 사용합니다.
# 기본 사전학습 모델. 일반 객체용이며 실제 오염 검출용이 아닙니다.
INSPECTION_MODEL_PATH=../yolo26n.pt
INSPECTION_CONFIDENCE=0.50

# 모델의 실제 클래스명과 일치시킵니다. * 는 모든 클래스를 결함으로 취급합니다.
INSPECTION_DEFECT_CLASSES=stain,discoloration,damage,tear,hole
INSPECTION_INFER_EVERY=2

# 전체 프레임과 겹치는 2x2 crop을 함께 추론해 작은 결함을 보강합니다.
INSPECTION_TILED=true
INSPECTION_TILE_ROWS=2
INSPECTION_TILE_COLUMNS=2
INSPECTION_TILE_OVERLAP=0.12
INSPECTION_NMS_IOU=0.45

# 현재 회색 의류/붉은 오염 촬영 조건용 규칙 기반 설정입니다.
HEURISTIC_MIN_AREA=90
HEURISTIC_MAX_AREA_RATIO=0.08
HEURISTIC_LAB_RED_MIN=135
HEURISTIC_MIN_SATURATION=35
HEURISTIC_ROI=0,0,1,0.85
HEURISTIC_MIN_SCORE=0.40
HEURISTIC_MAX_CANDIDATES=1
HEURISTIC_MIN_RED_EXCESS=3
HEURISTIC_MIN_LOCAL_RED_CONTRAST=1
HEURISTIC_MIN_CLOTH_FRACTION=0.20
HEURISTIC_BACKGROUND_THRESHOLD=18
HEURISTIC_MIN_GARMENT_AREA_RATIO=0.03

# 같은 위치에서 3회 연속 잡혀야 표시하고, 2회 연속 사라지면 해제합니다.
INSPECTION_CONFIRM_FRAMES=3
INSPECTION_RELEASE_FRAMES=2
